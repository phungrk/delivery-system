# Teams Incoming Webhook URLs
# Copy file này thành channels.env và điền URL thật vào
# File channels.env được .gitignore — KHÔNG commit URL thật lên git

# Webhook cho channel Team (devs + PMs)
# Lấy URL từ: Teams → Channel → ... → Connectors → Incoming Webhook
TEAMS_WEBHOOK_TEAM=https://xxx.webhook.office.com/webhookb2/TEAM_CHANNEL_URL_HERE

# Webhook cho channel Stakeholders (managers, clients)
TEAMS_WEBHOOK_STAKEHOLDER=https://xxx.webhook.office.com/webhookb2/STAKEHOLDER_CHANNEL_URL_HERE

# Tên hiển thị khi bot gửi message
TEAMS_BOT_NAME=Delivery Bot

# Đường dẫn tuyệt đối đến thư mục delivery-system (dùng cho cron)
DELIVERY_SYSTEM_DIR=/Users/phungnguyen/Downloads/delivery-system
